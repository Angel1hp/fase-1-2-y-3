{
  "short_name": "MiPDF",
  "name": "Mi Lector PDF",
  "description": "Lector de archivos PDF",
  "icons": [
    {
      "src": "icono-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "icono-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "index.html",
  "scope": "/",
  "background_color": "#ffffff",
  "display": "standalone",
  "theme_color": "#0066cc",
  "orientation": "portrait",
  "share_target": {
    "action": "index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdf_compartido",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  }
}
